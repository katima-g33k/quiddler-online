QUIDDLER_WEBSTER_BASE_URL=https://dictionaryapi.com/api/v3/references/collegiate/json
QUIDDLER_FREE_DICTIONARY_API_BASE=https://freedictionaryapi.com/api/v1/entries/en
QUIDDLER_CUSTOM_WORDS=./data/custom-words.txt
